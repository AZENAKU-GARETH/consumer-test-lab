# Copy this file to .env and fill in the values (or set them in your host's dashboard)

# Cloud database (used by Render/Neon). Leave empty to use local SQLite.
# Get this from Neon: https://neon.tech (Create project → Connections → Connection string)
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# Port the server listens on (Render sets this automatically)
PORT=4000